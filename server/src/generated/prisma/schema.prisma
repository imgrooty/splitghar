generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  // Relations
  sentRequests     Connection[]   @relation("SentRequests")
  receivedRequests Connection[]   @relation("ReceivedRequests")
  groupsOwned      Group[]        @relation("GroupOwner")
  groupsJoined     GroupMember[]
  expensesPaid     Expense[]
  splits           ExpenseSplit[]
  settlementsSent  Settlement[]   @relation("SettlementsFrom")
  settlementsRecv  Settlement[]   @relation("SettlementsTo")
}

model Connection {
  id          String   @id @default(uuid())
  requesterId String
  receiverId  String
  status      String // pending/accepted/blocked
  createdAt   DateTime @default(now())

  requester User @relation("SentRequests", fields: [requesterId], references: [id])
  receiver  User @relation("ReceivedRequests", fields: [receiverId], references: [id])
}

model Group {
  id        String   @id @default(uuid())
  name      String
  createdBy String
  createdAt DateTime @default(now())

  owner       User          @relation("GroupOwner", fields: [createdBy], references: [id])
  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]
}

model GroupMember {
  id      String @id @default(uuid())
  groupId String
  userId  String

  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
}

model Expense {
  id          String   @id @default(uuid())
  groupId     String
  description String
  amount      Float
  paidBy      String
  splitType   String // equal/custom/percentage
  createdAt   DateTime @default(now())

  group  Group          @relation(fields: [groupId], references: [id])
  payer  User           @relation(fields: [paidBy], references: [id])
  splits ExpenseSplit[]
}

model ExpenseSplit {
  id         String @id @default(uuid())
  expenseId  String
  userId     String
  amountOwed Float

  expense Expense @relation(fields: [expenseId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

model Settlement {
  id        String   @id @default(uuid())
  fromUser  String
  toUser    String
  groupId   String
  amount    Float
  method    String // upi/wallet/gift_card
  status    String // pending/completed
  createdAt DateTime @default(now())

  from  User  @relation("SettlementsFrom", fields: [fromUser], references: [id])
  to    User  @relation("SettlementsTo", fields: [toUser], references: [id])
  group Group @relation(fields: [groupId], references: [id])
}
